# Copy this file to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Contact email used in the descriptive User-Agent sent to Wikipedia/Wikidata,
# per their API etiquette (see https://meta.wikimedia.org/wiki/User-Agent_policy)
CLIO_CONTACT_EMAIL=you@example.com

# Optional overrides — defaults point at the repo's data/ directory
# SQLITE_PATH=/path/to/clio.db
# CHROMA_PATH=/path/to/chroma
# COW_DATA_DIR=/path/to/data/cow
# WIKIPEDIA_API_BASE=https://en.wikipedia.org/api/rest_v1
# WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql
# UCDP_API_BASE=https://ucdpapi.pcr.uu.se/api
