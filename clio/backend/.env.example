# Copy this file to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Leave unset to use Anthropic directly. To use an Anthropic-compatible
# provider instead (e.g. z.ai's GLM models), set both of these. Note the
# CLIO_ prefix — plain ANTHROPIC_BASE_URL is deliberately avoided since some
# shells/CI environments set that generic name for unrelated tooling and it
# would silently shadow this.
# CLIO_ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# ANTHROPIC_MODEL=glm-4.6
CLIO_ANTHROPIC_BASE_URL=

# Contact email used in the descriptive User-Agent sent to Wikipedia/Wikidata,
# per their API etiquette (see https://meta.wikimedia.org/wiki/User-Agent_policy)
CLIO_CONTACT_EMAIL=you@example.com

# Optional overrides — defaults point at the repo's data/ directory
# SQLITE_PATH=/path/to/clio.db
# CHROMA_PATH=/path/to/chroma
# COW_DATA_DIR=/path/to/data/cow
# WIKIPEDIA_API_BASE=https://en.wikipedia.org/api/rest_v1
# WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql
# UCDP_API_BASE=https://ucdpapi.pcr.uu.se/api
